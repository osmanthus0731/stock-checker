# Mongo
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_DB=inventory
FLASK_SECRET=supersecretkey

# Access
ACCESS_DB_PATH=C:\\path\\to\\Database1.accdb

# Live sync
SYNC_INTERVAL_SECONDS=60

# Optional purchase-order font directory. Windows Fonts is detected automatically.
# Supply licensed Lucida Fax (LFAX.TTF/LFAXD.TTF/LFAXI.TTF) and Century Gothic
# (GOTHICB.TTF) on Linux for the closest Titus layout. Built-in fonts are the fallback.
# PO_FONT_DIR=/app/fonts

# Inventory upgrade rollout gates. Keep writes off until user migration and staged Access tests pass.
INVENTORY_PLATFORM_ENABLED=1
STOCK_WRITES_ENABLED=0
PLATFORM_CONFIG_WRITES=0
